# Citadel WCF service. Staging — the environment accounts currently work on.
# Production (ftc.citadelinsight.com) no longer serves /InSightService/.
CITADEL_WCF_URL=http://staging.citadelinsight.com/InSightService/CitadelSvc.svc/json/

# Azure POS API, staging. Not used yet; here so it is never hardcoded.
CITADEL_AZURE_URL=https://citadelinsightposcentstg.azurewebsites.net/api/

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me

# Corporate daily-close board (GetDAStoreTotals). Same host, different endpoint.
CITADEL_DAILY_AUTOMATION_URL=http://staging.citadelinsight.com/InSightService/CitadelSvc.svc/DailyAutomationJson/
